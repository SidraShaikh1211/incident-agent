# --- Inference provider -----------------------------------------------------
# Gemini on Vertex AI. Authenticates with Application Default Credentials:
#   gcloud auth application-default login
INCIDENT_PROVIDER=gemini
INCIDENT_GCP_PROJECT=hack-team-treasury-geeks-2026
INCIDENT_VERTEX_REGION=global
# INCIDENT_VERTEX_PROJECT=        # defaults to INCIDENT_GCP_PROJECT

# INCIDENT_GEMINI_CLASSIFY_MODEL=gemini-3.5-flash
# INCIDENT_GEMINI_ROOTCAUSE_MODEL=gemini-3.5-flash
# INCIDENT_GEMINI_FIX_MODEL=gemini-3.5-flash
# INCIDENT_GEMINI_NARRATE_MODEL=gemini-3.5-flash
# INCIDENT_GEMINI_TEMPERATURE=0.2
# INCIDENT_GEMINI_MAX_STEPS=40
# INCIDENT_GEMINI_MAX_STAGE_TOKENS=600000   # cumulative input tokens per agentic stage
# INCIDENT_GEMINI_MAX_RETRIES=3
# INCIDENT_GEMINI_RETRY_BACKOFF_S=1.0

# Claude path (INCIDENT_PROVIDER=claude). Anthropic models are NOT enabled on
# this Vertex project, so this needs a logged-in `claude` CLI or an API key.
# ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT: Contents RW + Pull requests RW, scoped to the target repo.
GITHUB_TOKEN=

# --- Models, per agent ------------------------------------------------------
# INCIDENT_TRIAGE_MODEL=claude-opus-4-8
# INCIDENT_TRIAGE_EFFORT=medium
# INCIDENT_ROOTCAUSE_MODEL=claude-opus-4-8
# INCIDENT_ROOTCAUSE_EFFORT=high
# INCIDENT_FIX_MODEL=claude-opus-4-8
# INCIDENT_FIX_EFFORT=xhigh
# INCIDENT_NARRATE_MODEL=claude-opus-4-8
# INCIDENT_NARRATE_EFFORT=medium

# --- Reporting --------------------------------------------------------------
# Every finished run (PR or not) is announced. Default: a structured log line.
# A webhook URL receives a Slack-compatible {"text": ...} POST instead.
# INCIDENT_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# Keep finished RunRecords: none | json | firestore (firestore needs --extra gcp)
# INCIDENT_RUN_STORE=json
# INCIDENT_RUN_STORE_DIR=.incident-agent/runs

# --- Gates and limits -------------------------------------------------------
# INCIDENT_CONFIDENCE_THRESHOLD=0.7
# INCIDENT_ROOTCAUSE_THRESHOLD=0.7
# INCIDENT_MAX_FIX_ITERATIONS=3
# INCIDENT_VERIFY_BASELINE=true   # run the repo's tests before the fix too
# INCIDENT_MAX_BUDGET_USD=5.0
# INCIDENT_DRY_RUN=false

# --- Monorepo scoping -------------------------------------------------------
# INCIDENT_SPARK_SUBDIR=incident-resolver/scala-spark-application

# --- Pub/Sub ----------------------------------------------------------------
# INCIDENT_PUBSUB_TOPIC=spark-failures
